---
import Logo from "./Logo.astro";
import { NAV } from "../data/site";

interface Props {
  active?: string;
}
const { active = "" } = Astro.props;
---

<header class="top" id="top">
  <div class="wrap top-in">
    <a class="logo" href="/" aria-label="73rd Street Associates, home"><Logo /></a>
    <nav class="nav" aria-label="Main">
      {NAV.map((n) => <a href={n.href} aria-current={active === n.key ? "page" : undefined}>{n.label}</a>)}
    </nav>
    <div class="tools">
      <button class="icon-btn theme-btn" id="theme-btn" type="button" aria-label="Toggle dark mode">
        <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
        <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4.5"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
      </button>
      <button class="icon-btn menu-btn" id="menu-btn" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="sheet">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
      </button>
    </div>
  </div>
</header>
<nav class="sheet" id="sheet" aria-label="Mobile">
  {NAV.map((n) => <a href={n.href} aria-current={active === n.key ? "page" : undefined}>{n.label}</a>)}
</nav>
