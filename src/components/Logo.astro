---
// Wordmark: "73rd Street" on a teal street-sign plate, "Associates" beside it.
// Uses the page's own Archivo web font; public/logo.svg is the standalone copy.
interface Props {
  title?: string;
}
const { title = "73rd Street Associates" } = Astro.props;
---

<svg viewBox="0 0 392 64" role="img" aria-label={title} class="wordmark">
  <title>{title}</title>
  <g transform="rotate(-1.5 100 32)">
    <rect x="3" y="7" width="196" height="52" rx="10" fill="var(--shadow, #14201f)"></rect>
    <rect x="0" y="4" width="196" height="52" rx="10" fill="#0b7f7a" stroke="#14201f" stroke-width="2.5"></rect>
    <rect x="5.5" y="9.5" width="185" height="41" rx="6.5" fill="none" stroke="#fff" stroke-width="2"></rect>
    <text x="98" y="39.5" text-anchor="middle" textLength="164" lengthAdjust="spacingAndGlyphs" fill="#fff" font-family="Archivo, 'Arial Black', sans-serif" font-size="24" font-weight="850" font-stretch="118%" letter-spacing="-0.6">73rd Street</text>
  </g>
  <text x="210" y="43" textLength="170" lengthAdjust="spacingAndGlyphs" fill="currentColor" font-family="Archivo, 'Arial Black', sans-serif" font-size="27" font-weight="800" font-stretch="112%" letter-spacing="-0.8">Associates<tspan fill="#c2336b">.</tspan></text>
</svg>
